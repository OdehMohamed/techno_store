// Firestore rules — deployed as part of Phase 1 (see
// docs/ai-workflow/PHASE1C_EXECUTION_RUNBOOK.md). Companion to
// docs/ai-workflow/PHASE1_IMPLEMENTATION_PLAN.md for the original rationale
// and verification checklist.
//
// Scope: ADR-002 Phase 1 (role stored as a Firestore field, immutable from clients)
// + ADR-001 Option A (sensitive fields split into a `private/sensitive` subdocument)
// + ADR-003 (Guest is simply absent from every allow-list — no special-casing needed).
//
// Role storage: `users/{uid}.type` (int). 0=Admin, 1=Customer, 2=Reception,
// 3=Maintenance, 9=Guest (reserved, intentionally granted nothing below).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----

    function isSignedIn() {
      return request.auth != null;
    }

    // NOTE: this performs a document read on every rule evaluation that calls it.
    // See PHASE1_IMPLEMENTATION_PLAN.md's cost note — this is the expected,
    // accepted cost of Phase 1's field-based role model (Phase 2 / ADR-002
    // removes this cost via Custom Claims).
    function callerType() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type
        : null;
    }

    function isAdmin()       { return callerType() == 0; }
    function isCustomer()    { return callerType() == 1; }
    function isReception()   { return callerType() == 2; }
    function isMaintenance() { return callerType() == 3; }
    // Guest (9) and any unrecognized value: deliberately not given a helper.
    // Allow-list model — anything not explicitly named above gets nothing,
    // by construction, per ADR-003. Do not add isGuest()/grant it access
    // without a new ADR.

    function isStaff() {
      return isAdmin() || isReception() || isMaintenance();
    }

    // ADR-007: the technical-judgment boundary (Estimate creation, Technical
    // Finding, revision resolution) — Reception excluded, matching the
    // "can't be borrowed situationally" competence test.
    function isMaintenanceOrAdmin() {
      return isAdmin() || isMaintenance();
    }

    // ---- users/{uid} ----

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());

      // New profile creation: only the user themselves, and only as Customer.
      // Matches the only code path that creates this document today
      // (AuthServices.completeUserProfile, called once at signup).
      //
      // The stored phoneNumber must equal the phone number Firebase Auth
      // verified via OTP for this token (request.auth.token.phone_number) —
      // not merely whatever the client chooses to send. This is required for
      // functions/index.js's linkDevicesToNewCustomer to be trustworthy: that
      // function reads the verified phone directly from the Auth user
      // record (not this field) precisely so its correctness never depends
      // on this rule, but this rule still closes a real spoofing gap
      // elsewhere — e.g. NewDeviceServices.getUserIdByPhoneNumber (staff
      // linking a device by querying this users/{uid}.phoneNumber field) —
      // without this check, a customer could register with someone else's
      // phone number and have that person's devices misattributed.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.type == 1
        && request.resource.data.phoneNumber == request.auth.token.phone_number;

      // Profile updates: only the user themselves, and `type` may never change.
      // This applies even to Admins editing their own document — Phase 1
      // intentionally has NO client-side path to change any role, including
      // one's own. Role changes are Admin-SDK/Console only in Phase 1.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.type == resource.data.type;

      allow delete: if false; // no deletion flow exists today; revisit if one is built.

      // users/{uid}/meta/isActivated
      match /meta/{metaDoc} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
        // Confirmed by product owner (2026-07-03): this is currently changed
        // manually via the Firebase Console by a privileged operator, which
        // uses IAM-authenticated access and is NOT subject to these rules —
        // this deny-all-client-writes rule does not affect that workflow.
        // A future Admin user-management feature (see ADR-004) will need a
        // trusted server-side mechanism (Cloud Function) to write this field
        // on behalf of an in-app Admin action — never a direct client write,
        // which would reopen the same class of risk ADR-002 closes for `type`.
        allow write: if false;
      }
    }

    // ---- devices/{deviceId} ----
    // ADR-007 Phase 1: additive, unreachable by the currently-shipped
    // client — no code under lib/ references this collection yet. A
    // persistent Device identity anchor, distinct from any repair episode.
    match /devices/{deviceId} {
      // Staff-wide only, never customer — the structural prevention of
      // cross-customer exposure through a Device shared across Visits. A
      // customer's own view of "their device" comes only from the snapshot
      // already on their own Visit, never this collection directly.
      allow read: if isSignedIn() && isStaff();

      // brand/model/colorHex/imeiNumber all share identical staff-wide
      // write authority (ADR-007's matrix lists them as separate rows
      // during design, but the ratified authority is the same for both,
      // so one clause correctly implements all of them) — IMEI is
      // matching evidence, not identity, so no elevated tier is needed.
      //
      // hasOnly/hasAll together bound the exact key set (no single
      // "equals" exists for key sets in this rules language), closing
      // both extra-field injection and accidental removal of required
      // fields. Canonical field types are validated so a future buggy
      // client can't persist a non-string into a field the Device
      // Matching Policy's exact-IMEI-match pathway expects to be
      // textual evidence — deliberately not validating format/length,
      // which stays a later implementation concern.
      allow create: if isSignedIn() && isStaff()
        && request.resource.data.keys().hasOnly(
             ['brand', 'model', 'colorHex', 'imeiNumber', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['model', 'colorHex', 'createdAt', 'updatedAt'])
        && request.resource.data.model is string
        && request.resource.data.colorHex is string
        && (!('brand' in request.resource.data) || request.resource.data.brand is string)
        && (!('imeiNumber' in request.resource.data) || request.resource.data.imeiNumber is string)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // createdAt is immutable forever; updatedAt is server-authoritative
      // and must advance on every write, same anti-spoofing reasoning as
      // every other timestamp this ADR makes server-authoritative.
      //
      // brand/imeiNumber are absent from hasAll() deliberately: a later
      // write that omits a previously-set optional field is allowed to
      // clear it. That's optionality working as intended (e.g. correcting
      // a wrongly-entered IMEI back to unknown), not accidental data loss —
      // only the four required fields are protected from removal.
      allow update: if isSignedIn() && isStaff()
        && request.resource.data.keys().hasOnly(
             ['brand', 'model', 'colorHex', 'imeiNumber', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['model', 'colorHex', 'createdAt', 'updatedAt'])
        && request.resource.data.model is string
        && request.resource.data.colorHex is string
        && (!('brand' in request.resource.data) || request.resource.data.brand is string)
        && (!('imeiNumber' in request.resource.data) || request.resource.data.imeiNumber is string)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // Merge/reconciliation is a separate, higher-scrutiny future
      // capability — no client delete path today, matching the same
      // "no write path until deliberately designed" posture as the rest
      // of ADR-007's deferred items.
      allow delete: if false;
    }

    // ---- maintenanceDevices/{deviceId} ----

    match /maintenanceDevices/{deviceId} {
      // Staff: full unfiltered read. Customer: only their own device, AND
      // the client query must be shaped to match (e.g. a `where('userId', '==', uid)`
      // filter) — Firestore rejects list queries it can't prove are scoped to
      // this condition. The existing customer code path already filters this
      // way (MaintenanceListServices.streamMaintenanceDevices), so no query
      // shape change is expected to be needed — verify per the checklist.
      allow read: if isSignedIn() && (
        isStaff() ||
        (isCustomer() && resource.data.userId == request.auth.uid)
      );

      // Create is staff-wide (Admin, Reception, Maintenance), per explicit
      // product-owner decision (2026-07-03). Customers and Guest are denied.
      allow create: if isSignedIn() && isStaff();

      // recordState lifecycle — see ADR-005 (2026-07-23). Three distinct
      // transitions, replacing what used to be one blanket staff-wide update
      // rule:
      //  - Archive: any staff member may move a record that isn't already
      //    archived into `archived`. Preserves the document, Storage images,
      //    and the private/sensitive subdocument untouched — reversible.
      //  - Restore: Admin-only, archived -> active. Enforced here, not just
      //    by an Admin-only screen — a route/UI gate alone is not a
      //    substitute for the write itself being denied.
      //  - Ordinary edits (device details, Fixed/Deliver transitions):
      //    staff-wide, exactly as before this split existed, but only while
      //    the record isn't archived — an archived record is frozen until
      //    an Admin restores it (ADR-005, "Freezing archived records": no
      //    metadata-correction exception in v1).
      // `.get('recordState', 'active')` treats any document written before
      // this field existed (no recordState at all) as implicitly active, so
      // this rule doesn't retroactively break every pre-migration document
      // the moment it deploys — see ADR-005 "Migration".
      allow update: if isSignedIn() && (
        (isStaff()
          && resource.data.get('recordState', 'active') != 'archived'
          && request.resource.data.recordState == 'archived') ||
        (isAdmin()
          && resource.data.get('recordState', 'active') == 'archived'
          && request.resource.data.recordState == 'active') ||
        (isStaff()
          && resource.data.get('recordState', 'active') != 'archived'
          && request.resource.data.get('recordState', 'active') != 'archived')
      );

      // Permanent deletion moved server-side (ADR-005): the
      // permanentlyDeleteDevice Cloud Function uses the Admin SDK, which
      // bypasses these rules entirely, so it needs no client `delete`
      // permission here at all. The client no longer calls `.delete()` on
      // this collection anywhere — see MaintenanceListServices (Archive is
      // an `update`, not a `delete`).
      allow delete: if false;

      // Sensitive fields (pin, patternLock, notesHidden) — ADR-001 Option A.
      // No customer exception, ever, per explicit product-owner instruction:
      // the owning customer must never read these values.
      match /private/{doc} {
        allow read: if isSignedIn() && isStaff();
        allow create, update: if isSignedIn() && isStaff();
        // Deletion also moved server-side (ADR-005) — same reasoning as
        // the parent document's `delete` rule above.
        allow delete: if false;
      }

      // Append-only provenance log for Archive/Restore — see ADR-005.
      // Deliberately lighter-weight than auditLogs (which only a Cloud
      // Function can write): Archive/Restore are both reversible, so a
      // forged entry here is low-stakes and independently checkable against
      // the document's actual recordState. The strongest guarantee
      // (auditLogs + Cloud Function) is reserved for Permanent Deletion,
      // the one irreversible operation. No update/delete granted to any
      // client — each event's own `type` determines who may create it,
      // mirroring the same authority split as the transitions above.
      match /lifecycleEvents/{eventId} {
        allow read: if isSignedIn() && isStaff();
        allow create: if isSignedIn() && (
          (isStaff() && request.resource.data.type == 'archived') ||
          (isAdmin() && request.resource.data.type == 'restored')
        );
        allow update, delete: if false;
      }

      // ---- estimates/{estimateId} ----
      // ADR-007 Phase 1: additive, unreachable by the currently-shipped
      // client. Immutable revision sequence with a server-authoritative
      // ordering key; see ADR-007 §8 and its Pending-Revision-Resolution
      // correction (§7) for the full reasoning behind this shape.
      match /estimates/{estimateId} {
        // Staff-wide, or the owning customer via a cross-document check on
        // the parent Visit — mirrors the existing customer-owns-this-device
        // pattern already used in storage.rules. A single get() on a known
        // document by ID is the same cheap class as this file's own
        // callerType() helper, not the expensive cross-document scan class
        // ADR-007 reserves for app-layer enforcement.
        allow read: if isSignedIn() && (
          isStaff() ||
          (isCustomer() &&
           get(/databases/$(database)/documents/maintenanceDevices/$(deviceId)).data.userId == request.auth.uid)
        );

        // Maintenance + Admin only — diagnosis and proposing scope/cost is
        // technical judgment, the one competence that can't be borrowed
        // situationally (Roles as Expertise). Exactly the 5 required keys;
        // decision/resolution fields don't exist on the document at all
        // until their own later one-time write adds them — this is what
        // stops a client from setting e.g. resolutionOutcome directly at
        // creation, bypassing the whole one-time-transition discipline.
        // createdAt is server-authoritative so a client can never misorder
        // a genuinely newer Estimate behind the one it supersedes.
        //
        // NOT enforced here, per ADR-007 §7: blocking creation while
        // another qualifying decline on this Visit is still unresolved —
        // that precondition is a cross-document scan against sibling
        // Estimates, the same expensive class as the finalAmountCharged
        // ceiling check, explicitly left app-layer for v1.
        allow create: if isSignedIn() && isMaintenanceOrAdmin()
          && request.resource.data.keys().hasOnly(
               ['proposedScope', 'proposedAmount', 'createdByUid', 'createdAt', 'outcome'])
          && request.resource.data.keys().hasAll(
               ['proposedScope', 'proposedAmount', 'createdByUid', 'createdAt', 'outcome'])
          && request.resource.data.proposedScope is string
          && request.resource.data.proposedAmount is number
          && request.resource.data.proposedAmount >= 0
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.outcome == 'pending';

        // Three mutually-exclusive one-time transitions on the same
        // document, distinguished by diff().affectedKeys().hasOnly(...)
        // rather than per-field equality checks alone — equality checks on
        // a chosen subset of fields can't stop a write from adding an
        // entirely new, never-checked field; bounding the whole changed-key
        // set closes that gap. Provenance fields (decidedByUid/
        // resolvedByUid) are pinned to request.auth.uid so an authorized
        // writer can never attribute the action to someone else.
        // NOTE on request.resource.data field access: direct dot-access to
        // a key that's genuinely absent from the resulting document throws
        // a rules evaluation error rather than returning a graceful
        // false/null — confirmed empirically (not merely assumed) via this
        // suite's own first run, where an Admin approval tripped an error
        // inside the *resolution* branch despite that branch being
        // irrelevant to the write. Every field below that isn't guaranteed
        // present on every branch's resulting document uses
        // .get(field, default), matching this file's pre-existing
        // recordState precedent, rather than bare dot-access.
        allow update: if isSignedIn() && (
          ( // decision recording — approve: declineReason never touchable here
            isStaff()
            && resource.data.outcome == 'pending'
            && request.resource.data.outcome == 'approved'
            && request.resource.data.get('decidedByUid', null) == request.auth.uid
            && request.resource.data.get('decidedAt', null) == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['outcome', 'decidedByUid', 'decidedAt'])
          ) ||
          ( // decision recording — decline: declineReason optional, only
            // settable in this same write, frozen with everything else the
            // instant it completes (resource.data.outcome == 'pending' can
            // never be true again afterward, so there's no later path back
            // to this branch to re-touch it)
            isStaff()
            && resource.data.outcome == 'pending'
            && request.resource.data.outcome == 'declined'
            && request.resource.data.get('decidedByUid', null) == request.auth.uid
            && request.resource.data.get('decidedAt', null) == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['outcome', 'decidedByUid', 'decidedAt', 'declineReason'])
            && (!('declineReason' in request.resource.data) || request.resource.data.declineReason is string)
          ) ||
          ( // resolution recording — Maintenance + Admin only; requires an
            // already-declined outcome (never settable on 'pending' or
            // 'approved'); resolutionOutcome/resolvedByUid/resolvedAt
            // genuinely don't exist on the document until this branch adds
            // them, hence .get() throughout rather than bare access
            isMaintenanceOrAdmin()
            && resource.data.outcome == 'declined'
            && resource.data.get('resolutionOutcome', null) == null
            && request.resource.data.get('resolutionOutcome', null) in ['continue', 'stop']
            && request.resource.data.get('resolvedByUid', null) == request.auth.uid
            && request.resource.data.get('resolvedAt', null) == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['resolutionOutcome', 'resolvedByUid', 'resolvedAt'])
          )
        );

        allow delete: if false;
      }
    }

    // ---- appConfig/global ----
    // Global app configuration (today: forced-update version gate; reserved
    // for maintenance mode / feature flags later — see
    // docs/ai-workflow/FORCED_UPDATE_IMPLEMENTATION_PLAN.md). Non-sensitive
    // operational metadata only — readable by anyone, including signed-out
    // users, since the sign-in screen itself must be forceable. No in-app
    // admin UI writes it in v1; edited manually via Console/Admin SDK, same
    // operating model as users/{uid}/meta/isActivated.
    match /appConfig/global {
      allow read: if true;
      allow write: if false;
    }

    // Explicit default-deny for everything else (Firestore denies by default
    // anyway; written out for clarity/auditability of this rules file).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
